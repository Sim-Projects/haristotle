// Haristotle Blog Platform - Prisma Schema
// Blog platform with Notion-like editor, similar to Medium

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication Models
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Core User Model
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?   // For credential-based auth
  image         String?
  username      String?   @unique
  bio           String?
  website       String?
  twitter       String?
  linkedin      String?
  github        String?
  location      String?
  isVerified    Boolean   @default(false) @map("is_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Authentication relations
  accounts Account[]
  sessions Session[]

  // Content relations
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  views         View[]
  
  // Social relations
  followers     Follow[] @relation("UserFollowers")
  following     Follow[] @relation("UserFollowing")
  
  // Notification relations
  notifications Notification[]

  @@map("users")
}

// Content Models
model Post {
  id             String      @id @default(cuid())
  slug           String      @unique
  status         PostStatus  @default(DRAFT)
  publishedAt    DateTime?   @map("published_at")
  readingTime    Int?        @map("reading_time") // in minutes
  viewCount      Int         @default(0) @map("view_count")
  likesCount     Int         @default(0) @map("likes_count")
  commentsCount  Int         @default(0) @map("comments_count")
  bookmarksCount Int         @default(0) @map("bookmarks_count")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Author relation
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Content relations
  draftContent     DraftContent?
  publishedContent PublishedContent?

  // Category and tag relations
  categories CategoryOnPost[]
  tags       TagOnPost[]

  // Engagement relations
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  views     View[]

  // AI Components relation
  aiComponents AIComponent[]

  @@map("posts")
}

// Draft content - always editable
model DraftContent {
  id            String   @id @default(cuid())
  postId        String   @unique @map("post_id")
  title         String
  content       Json     // BlockNote content as JSON
  excerpt       String?
  featuredImage String?  @map("featured_image")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("draft_contents")
}

// Published content - read-only (updated only during publish)
model PublishedContent {
  id            String   @id @default(cuid())
  postId        String   @unique @map("post_id")
  title         String
  content       Json     // BlockNote content as JSON
  excerpt       String?
  featuredImage String?  @map("featured_image")
  publishedAt   DateTime @default(now()) @map("published_at")
  createdAt     DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("published_contents")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PRIVATE
}

// Category System
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?
  image       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts CategoryOnPost[]

  @@map("categories")
}

model CategoryOnPost {
  id String @id @default(cuid())

  postId     String @map("post_id")
  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@map("category_on_post")
}

// Tag System
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts TagOnPost[]

  @@map("tags")
}

model TagOnPost {
  id String @id @default(cuid())

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("tag_on_post")
}

// Engagement Models
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Author relation
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Post relation
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Threading support
  parentId String?   @map("parent_id")
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model View {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("views")
}

// Social Features
model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  followerId String @map("follower_id")
  follower   User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String @map("following_id")
  following   User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

// Notification System
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  data      Json? // Additional data for the notification
  createdAt DateTime         @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  POST_PUBLISHED
  MENTION
}

// AI Component Generation System
model AIComponent {
  id                      String   @id @default(cuid())
  blockId                 String   @unique @map("block_id") // Unique identifier for the block in BlockNote
  postId                  String   @map("post_id")
  currentDraftVersionId   String?  @unique @map("current_draft_version_id")
  currentPublishedVersionId String? @unique @map("current_published_version_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  post                    Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  versions                AIComponentVersion[]
  currentDraftVersion     AIComponentVersion?   @relation("CurrentDraftVersion", fields: [currentDraftVersionId], references: [id])
  currentPublishedVersion AIComponentVersion?   @relation("CurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id])

  @@map("ai_components")
}

model AIComponentVersion {
  id            String   @id @default(cuid())
  componentId   String   @map("component_id")
  prompt        String   @db.Text
  generatedCode String   @map("generated_code") @db.Text
  versionNumber Int      @map("version_number")
  status        AIGenerationStatus @default(GENERATING)
  mode          AIComponentMode @default(DRAFT) // Track draft vs published
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  component                    AIComponent   @relation(fields: [componentId], references: [id], onDelete: Cascade)
  currentDraftForComponent     AIComponent? @relation("CurrentDraftVersion")
  currentPublishedForComponent AIComponent? @relation("CurrentPublishedVersion")

  @@unique([componentId, versionNumber])
  @@map("ai_component_versions")
}

enum AIGenerationStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum AIComponentMode {
  DRAFT
  PUBLISHED
}
